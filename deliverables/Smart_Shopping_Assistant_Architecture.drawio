        <mxCell id="title" value="Telekom Smart Shopping Assistant — AI-Powered Omnichannel Consumer Intelligence Engine" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#E20074;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Core principle:  AI generates &#8594; Deterministic rules decide.  The LLM converses, ranks &amp; explains; a deterministic engine decides what is actually offerable, so it never hallucinates a product." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#4A5560;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1620" height="24" as="geometry" />
