        <mxCell id="a2" value="② Profile Agent&#10;update_profile()&#10;learns budget · brands · features&#10;· rejected items (continuous learning,&#10;user correctable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBE0;strokeColor=#B01C6E;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="615" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="③ Retrieval Agent&#10;retrieve()  RAG&#10;semantic top-k (Qdrant) OR&#10;keyword mock — finds candidates&#10;by intent &amp; meaning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBE0;strokeColor=#B01C6E;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="615" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="④ Eligibility Engine  ★ SOURCE OF TRUTH&#10;filter_eligible()  —  pure, deterministic&#10;HARD rules: in-stock · within budget&#10;· brand match · type match&#10;NO LLM, ever — 0% hallucination risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="615" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="⑤ Recommender + Explainer + Next-Best-Action  (recommender.py)&#10;rank_products(): 4 signals — relevance · preference · budget · popularity, blended with cold-start &#8594; warm-start weights  ·  diversifies to top-3&#10;&quot;Why this for you?&quot;  (LLM sentence or deterministic template, grounded in real signals)  ·  Next-Best-Action nudges (bundle / accessory / free-shipping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBE0;strokeColor=#B01C6E;fontSize=11;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="745" width="1100" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="⑥ GUARDRAIL — recommendations &#8838; eligible ids  (belt &amp; braces: enforced in recommender AND graph.py)      +      ⑦ Receipts — retrieved_ids · rules_fired · shown_ids  (auditable decision log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8D5;strokeColor=#C0392B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="840" width="1100" height="60" as="geometry" />
