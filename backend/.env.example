# Copy this file to `.env` and fill in values.
# To START (mock mode), you don't need any keys - just keep MOCK_MODE=true.

MOCK_MODE=true

# --- OpenAI (intent extraction + "why" explanations) ---
# Get a key from https://platform.openai.com/api-keys. If this is missing/wrong,
# the app automatically falls back to mock intent parsing / template "why" text -
# it never crashes the pipeline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Qdrant + RAG (run Qdrant locally: docker compose up -d qdrant) ---
# For Qdrant Cloud, replace QDRANT_URL with the HTTPS cluster endpoint from
# the Connect panel and set its API key below.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=product_embeddings
# RAG_ENABLED=true turns on semantic (vector) retrieval. Needs the RAG deps
# installed and the collection ingested (python -m app.rag.ingestion). Falls back
# to keyword matching automatically if Qdrant/deps are unavailable.
RAG_ENABLED=false

# --- Embeddings (local, free, no key needed) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Session persistence (P4) ---
# SESSION_BACKEND: auto (default) | memory | supabase
#   auto -> use Supabase when the two vars below are set, otherwise in-memory.
# Leave SUPABASE_* blank to run fully in-memory (no setup needed).
# To persist: create a project at https://supabase.com, run
#   app/session/supabase_schema.sql in the SQL editor, then paste the Project URL
#   and the service_role key below.
# SUPABASE_URL is the Project URL from Settings -> API (https://<ref>.supabase.co).
# SUPABASE_KEY is a service key from that SAME page (a JWT service_role key, or a
#   new-style "sb_secret_..." secret) - NOT the database password.
# NOTE: we talk to Supabase over the REST API (supabase-py), not a direct psycopg2
#   Postgres connection - the direct db.<ref>.supabase.co host is IPv6-only and
#   often won't resolve, whereas the REST endpoint always works over HTTPS.
SESSION_BACKEND=auto
SUPABASE_URL=
SUPABASE_KEY=

# --- Catalog (prices/stock) source ---
# auto -> read the `catalog_products` table from Supabase (run
#   app/retrieval/catalog_schema.sql once, then: python -m app.retrieval.seed_catalog),
#   falling back to the JSON data files if it's empty/unreachable.
# json -> always read data/*.json (offline; used by the eval harness).
CATALOG_BACKEND=auto
CATALOG_TABLE=catalog_products

# --- Auth ---
# Uses SUPABASE_URL/KEY above (the `users` table). Run app/auth/supabase_schema.sql once.
# AUTH_SECRET signs login tokens - change it to anything random for a real deploy.
AUTH_SECRET=dev-insecure-secret-change-me
AUTH_TOKEN_TTL_SECONDS=604800
