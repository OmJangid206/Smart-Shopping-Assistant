# Copy this file to `.env` and fill in values.
# To START (mock mode), you don't need any keys - just keep MOCK_MODE=true.

MOCK_MODE=true

# --- Grok / xAI (get a key from https://console.x.ai) ---
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# --- Qdrant (run locally: docker compose up -d qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telekom_catalog

# --- Embeddings (local, free, no key needed) ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Session persistence (P4) ---
# SESSION_BACKEND: auto (default) | memory | supabase
#   auto -> use Supabase when the two vars below are set, otherwise in-memory.
# Leave SUPABASE_* blank to run fully in-memory (no setup needed).
# To persist: create a project at https://supabase.com, run
#   app/session/supabase_schema.sql in the SQL editor, then paste the Project URL
#   and the service_role key below.
# SUPABASE_URL is the Project URL from Settings -> API (https://<ref>.supabase.co).
# SUPABASE_KEY is the service_role secret from that SAME page, under
#   "Project API keys" - NOT the database password from Settings -> Database.
SESSION_BACKEND=auto
SUPABASE_URL=
SUPABASE_KEY=

# --- Auth (P4) ---
# Also uses SUPABASE_URL/KEY above (a `users` table alongside `sessions`).
# Run app/auth/supabase_schema.sql once too, if you're using Supabase.
# AUTH_SECRET signs login tokens - change it to anything random for a real deploy.
AUTH_SECRET=dev-insecure-secret-change-me
AUTH_TOKEN_TTL_SECONDS=604800
